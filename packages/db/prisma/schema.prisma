generator client {
  provider        = "prisma-client-js"
  binaryTargets   = ["native", "rhel-openssl-3.0.x", "debian-openssl-3.0.x"]
  previewFeatures = ["relationJoins"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Organization {
  id           String            @id @default(cuid())
  name         String
  slug         String            @unique
  customDomain String?           @unique
  logoUrl      String?
  brandColor   String?           @default("#7c3aed")
  supportEmail String?
  loginHeading     String?
  loginSubheading  String?
  loginBannerUrl   String?
  tagline          String?
  testimonialQuote String?
  testimonialAuthor String?
  isActive     Boolean           @default(true)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @default(now()) @updatedAt
  employees    Employee[]
  departments  Department[]
  designations Designation[]
  leaveTypes         LeaveType[]
  settings           CompanySettings[]
  googleSheetConfig  GoogleSheetConfig?
  telegramConfigs    TelegramAutomationConfig[]
  targets            EmployeeTarget[]
}

model Employee {
  id               String         @id @default(cuid())
  employeeCode     String         @unique // e.g. "RS-0001"
  firstName        String
  lastName         String
  email            String         @unique
  passwordHash     String
  organizationId   String         @default("org_default_realty")
  organization     Organization   @relation(fields: [organizationId], references: [id])
  phone            String?
  role             Role           @default(EMPLOYEE)
  designationId    String?
  designation      Designation?   @relation(fields: [designationId], references: [id])
  departmentId     String?
  department       Department?    @relation(fields: [departmentId], references: [id])
  managerId        String?
  manager          Employee?      @relation("ManagerReports", fields: [managerId], references: [id])
  directReports    Employee[]     @relation("ManagerReports")
  dateOfJoining    DateTime?
  dateOfBirth      DateTime?
  address          String?
  profilePhotoUrl  String?
  status           EmployeeStatus @default(ACTIVE)
  // Punch sites (legacy single + up to 3 in assignedLocations JSON)
  workLocationLat  Float?
  workLocationLng  Float?
  workLocationName String?
  /// Up to 3 sites: [{ "name": string, "lat": number, "lng": number }]
  assignedLocations Json?
  attendanceLogs   AttendanceLog[]
  leaveBalances    LeaveBalance[]
  leaveRequests    LeaveRequest[]
  approvedLeaves   LeaveRequest[] @relation("LeaveApprover")
  postedJobs         JobPosting[]
  referredCandidates Candidate[]      @relation("CandidateReferral")
  interviewRounds    InterviewRound[]
  candidateNotes     CandidateNote[]
  jobHistory         EmployeeJobHistory[] @relation("JobHistoryEmployee")
  jobChangesMade     EmployeeJobHistory[] @relation("JobHistoryChangedBy")
  documents          EmployeeDocument[]   @relation("DocumentOwner")
  uploadedDocuments  EmployeeDocument[]   @relation("DocumentUploader")
  locationPings      LocationPing[]
  pushSubscriptions  PushSubscription[]
  goals              Goal[]               @relation("EmployeeGoals")
  reviewsReceived    Review[]             @relation("EmployeeReviews")
  reviewsGiven       Review[]             @relation("ReviewsGiven")
  createdCycles      PerformanceCycle[]   @relation("CreatedCycles")
  assignedTargets    EmployeeTarget[]     @relation("EmployeeAssignedTargets")
  createdTargets     EmployeeTarget[]     @relation("EmployeeCreatedTargets")
  targetActivities   TargetActivity[]     @relation("EmployeeTargetActivities")
  gender               String?
  emergencyContactName String?
  emergencyContactPhone String?
  bloodGroup           String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@index([organizationId])
  @@index([organizationId, email])
}

enum Role {
  ADMIN
  HR
  MANAGER
  EMPLOYEE
}

enum EmployeeStatus {
  ACTIVE
  ON_LEAVE
  RESIGNED
  TERMINATED
  EXIT // left without formal resignation
}

model Department {
  id             String        @id @default(cuid())
  name           String        @unique
  organizationId String?       @default("org_default_realty")
  organization   Organization? @relation(fields: [organizationId], references: [id])
  employees      Employee[]
  jobPostings JobPosting[]
  createdAt   DateTime     @default(now())
}

model Designation {
  id             String        @id @default(cuid())
  title          String        @unique
  organizationId String?       @default("org_default_realty")
  organization   Organization? @relation(fields: [organizationId], references: [id])
  employees      Employee[]
  createdAt DateTime   @default(now())
}

model AttendanceLog {
  id              String           @id @default(cuid())
  employeeId      String
  employee        Employee         @relation(fields: [employeeId], references: [id])
  date            DateTime         @db.Date
  checkInTime     DateTime?
  checkInLat      Float?
  checkInLng      Float?
  checkInAddress  String?
  checkOutTime    DateTime?
  checkOutLat     Float?
  checkOutLng     Float?
  checkOutAddress String?
  status          AttendanceStatus @default(PRESENT)
  withinGeofence  Boolean          @default(true)
  totalHours      Float?
  notes           String?
  createdAt       DateTime         @default(now())
  punches         AttendancePunch[]

  @@unique([employeeId, date])
  @@index([date])
}

model AttendancePunch {
  id              String        @id @default(cuid())
  attendanceLogId String
  attendanceLog   AttendanceLog @relation(fields: [attendanceLogId], references: [id], onDelete: Cascade)
  checkInTime     DateTime
  checkInAddress  String?
  checkOutTime    DateTime?
  checkOutAddress String?

  @@index([attendanceLogId])
}

enum AttendanceStatus {
  PRESENT
  LATE
  HALF_DAY
  ABSENT
  ON_LEAVE
  HOLIDAY
}

model LeaveType {
  id                  String         @id @default(cuid())
  name                String         @unique
  organizationId      String?        @default("org_default_realty")
  organization        Organization?  @relation(fields: [organizationId], references: [id])
  annualQuota         Int
  carryForwardAllowed Boolean        @default(false)
  requiresApproval    Boolean        @default(true)
  leaveRequests       LeaveRequest[]
  balances            LeaveBalance[]
}

model LeaveBalance {
  id          String    @id @default(cuid())
  employeeId  String
  employee    Employee  @relation(fields: [employeeId], references: [id])
  leaveTypeId String
  leaveType   LeaveType @relation(fields: [leaveTypeId], references: [id])
  year        Int
  allotted    Float
  used        Float     @default(0)
  remaining   Float
  updatedAt   DateTime  @updatedAt

  @@unique([employeeId, leaveTypeId, year])
}

model LeaveRequest {
  id           String      @id @default(cuid())
  employeeId   String
  employee     Employee    @relation(fields: [employeeId], references: [id])
  leaveTypeId  String
  leaveType    LeaveType   @relation(fields: [leaveTypeId], references: [id])
  startDate    DateTime    @db.Date
  endDate      DateTime    @db.Date
  numberOfDays Float
  isHalfDay    Boolean     @default(false)
  /// FIRST_HALF = works till 2:30 PM, SECOND_HALF = works from 2:30 PM
  halfDaySlot  String?
  reason       String
  status       LeaveStatus @default(PENDING)
  approvedById String?
  approvedBy   Employee?   @relation("LeaveApprover", fields: [approvedById], references: [id])
  approverNote String?
  appliedAt    DateTime    @default(now())
  respondedAt  DateTime?
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

model CompanySettings {
  id              String        @id @default("singleton")
  organizationId  String?       @default("org_default_realty")
  organization    Organization? @relation(fields: [organizationId], references: [id])
  officeName      String @default("Realty Smartz Private Limited HQ")
  officeLat       Float
  officeLng       Float
  geofenceRadiusM Int    @default(200)
  /// JS getDay(): 0=Sun … 6=Sat. Realty Smartz Private Limited weekly off = Tuesday (2).
  weeklyOffDay        Int     @default(2)
  lateCheckInTime     String  @default("10:30")
  halfDayCheckInTime  String  @default("11:00")
  latesPerHalfDayCut  Int     @default(3)
  probationMonths     Int     @default(6)
  sandwichRuleEnabled Boolean @default(true)
}

model LocationPing {
  id             String   @id @default(cuid())
  employeeId     String
  employee       Employee @relation(fields: [employeeId], references: [id])
  lat            Float
  lng            Float
  address        String?
  accuracyM      Float?
  withinGeofence Boolean  @default(true)
  capturedAt     DateTime @default(now())

  @@index([employeeId, capturedAt])
}

model PushSubscription {
  id         String   @id @default(cuid())
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  endpoint   String   @unique
  p256dh     String
  auth       String
  createdAt  DateTime @default(now())

  @@index([employeeId])
}

model JobPosting {
  id             String         @id @default(cuid())
  title          String
  departmentId   String?
  department     Department?    @relation(fields: [departmentId], references: [id])
  description    String
  requirements   String
  location       String         @default("Gurugram")
  employmentType EmploymentType @default(FULL_TIME)
  status         JobStatus      @default(OPEN)
  postedById     String
  postedBy       Employee       @relation(fields: [postedById], references: [id])
  candidates     Candidate[]
  createdAt      DateTime       @default(now())
  closedAt       DateTime?
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
  INTERNSHIP
}

enum JobStatus {
  OPEN
  ON_HOLD
  CLOSED
}

model Candidate {
  id           String          @id @default(cuid())
  jobPostingId String
  jobPosting   JobPosting      @relation(fields: [jobPostingId], references: [id])
  fullName     String
  email        String
  phone        String
  resumeUrl    String?
  source       CandidateSource @default(DIRECT)
  referredById String?
  referredBy   Employee?       @relation("CandidateReferral", fields: [referredById], references: [id])
  currentStage PipelineStage   @default(APPLIED)
  interviews   InterviewRound[]
  notes        CandidateNote[]
  appliedAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
}

enum CandidateSource {
  DIRECT
  REFERRAL
  JOB_BOARD
  LINKEDIN
  OTHER
}

enum PipelineStage {
  APPLIED
  SCREENING
  INTERVIEW
  OFFER
  HIRED
  REJECTED
}

model InterviewRound {
  id            String          @id @default(cuid())
  candidateId   String
  candidate     Candidate       @relation(fields: [candidateId], references: [id])
  roundName     String
  interviewerId String
  interviewer   Employee        @relation(fields: [interviewerId], references: [id])
  scheduledAt   DateTime
  status        InterviewStatus @default(SCHEDULED)
  feedback      String?
  rating        Int?
  createdAt     DateTime        @default(now())
}

enum InterviewStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
  NO_SHOW
}

model CandidateNote {
  id          String    @id @default(cuid())
  candidateId String
  candidate   Candidate @relation(fields: [candidateId], references: [id])
  authorId    String
  author      Employee  @relation(fields: [authorId], references: [id])
  content     String
  createdAt   DateTime  @default(now())
}

model EmployeeJobHistory {
  id            String   @id @default(cuid())
  employeeId    String
  employee      Employee @relation("JobHistoryEmployee", fields: [employeeId], references: [id])
  fieldChanged  String
  oldValue      String?
  newValue      String?
  effectiveDate DateTime @default(now())
  changedById   String?
  changedBy     Employee? @relation("JobHistoryChangedBy", fields: [changedById], references: [id])
  createdAt     DateTime @default(now())

  @@index([employeeId])
}

enum DocumentType {
  PAN_CARD
  AADHAR_CARD
  OFFER_LETTER
  EDUCATIONAL_CERTIFICATE
  OTHER
}

model EmployeeDocument {
  id           String       @id @default(cuid())
  employeeId   String
  employee     Employee     @relation("DocumentOwner", fields: [employeeId], references: [id])
  documentType DocumentType @default(OTHER)
  title        String?
  fileUrl      String
  uploadedById String
  uploadedBy   Employee     @relation("DocumentUploader", fields: [uploadedById], references: [id])
  uploadedAt   DateTime     @default(now())

  @@index([employeeId])
}

model PerformanceCycle {
  id          String           @id @default(cuid())
  name        String           // e.g. "H1 2026 Review", "Q1 2026 OKRs"
  cycleType   CycleType        @default(APPRAISAL)
  startDate   DateTime         @db.Date
  endDate     DateTime         @db.Date
  status      CycleStatus      @default(DRAFT)
  goals       Goal[]
  reviews     Review[]
  createdById String
  createdBy   Employee         @relation("CreatedCycles", fields: [createdById], references: [id])
  createdAt   DateTime         @default(now())
}

enum CycleType {
  APPRAISAL   // traditional periodic performance review
  OKR         // objectives & key results cycle
}

enum CycleStatus {
  DRAFT       // being set up by HR/Admin, not visible to employees yet
  ACTIVE      // goals can be set, self/manager reviews open
  CLOSED      // cycle complete, reviews finalized
}

model Goal {
  id              String           @id @default(cuid())
  cycleId         String
  cycle           PerformanceCycle @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  employeeId      String
  employee        Employee         @relation("EmployeeGoals", fields: [employeeId], references: [id], onDelete: Cascade)
  title           String
  description     String?
  category        GoalCategory     @default(INDIVIDUAL)
  targetValue     String?          // e.g. "10 units sold", free text since KPIs vary
  progressPercent Int              @default(0)
  status          GoalStatus       @default(NOT_STARTED)
  keyResults      KeyResult[]      // for OKR-type cycles
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([cycleId, employeeId])
}

enum GoalCategory {
  INDIVIDUAL
  TEAM
  COMPANY
}

enum GoalStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
  MISSED
}

model KeyResult {
  id              String   @id @default(cuid())
  goalId          String
  goal            Goal     @relation(fields: [goalId], references: [id], onDelete: Cascade)
  description     String
  progressPercent Int      @default(0)
  completed       Boolean  @default(false)

  @@index([goalId])
}

model Review {
  id           String           @id @default(cuid())
  cycleId      String
  cycle        PerformanceCycle @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  employeeId   String
  employee     Employee         @relation("EmployeeReviews", fields: [employeeId], references: [id], onDelete: Cascade)
  reviewerId   String
  reviewer     Employee         @relation("ReviewsGiven", fields: [reviewerId], references: [id], onDelete: Cascade)
  reviewType   ReviewType
  rating       Int?             // 1-5 overall rating
  strengths    String?
  improvements String?
  comments     String?
  status       ReviewStatus     @default(PENDING)
  submittedAt  DateTime?
  createdAt    DateTime         @default(now())

  @@unique([cycleId, employeeId, reviewerId, reviewType])
  @@index([cycleId, employeeId])
}

enum ReviewType {
  SELF
  MANAGER
}

enum ReviewStatus {
  PENDING
  SUBMITTED
}

model GoogleSheetConfig {
  id                  String       @id @default(cuid())
  organizationId      String       @unique
  organization        Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  spreadsheetId       String?
  serviceAccountEmail String?
  privateKey          String?
  webhookUrl          String?
  autoSyncEnabled     Boolean      @default(true)
  lastSyncedAt        DateTime?
  lastSyncStatus      String?
  lastSyncRows        Int?
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @default(now()) @updatedAt
}

model TelegramAutomationConfig {
  id               String        @id @default(cuid())
  organizationId   String        @default("org_default_realty")
  organization     Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  channelType      String        // "ATTENDANCE_LEAVE" or "HR_LIFECYCLE"
  name             String        // e.g. "Attendance & Leaves Bot" or "HR & Employee Lifecycle Bot"
  botToken         String?
  chatId           String?
  chatTitle        String?
  enabled          Boolean       @default(false)
  
  // Attendance & Leaves flags
  notifyPunchIn    Boolean       @default(true)
  notifyPunchOut   Boolean       @default(true)
  notifyLeave      Boolean       @default(true)
  notifyBirthday   Boolean       @default(true)
  
  // HR / Lifecycle flags
  notifyNewJoin    Boolean       @default(true)
  notifyCandidate  Boolean       @default(true)
  notifyResigned   Boolean       @default(true)
  notifyTerminated Boolean       @default(true)

  lastTestSentAt   DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@unique([organizationId, channelType])
}



model EmployeeTarget {
  id               String           @id @default(cuid())
  organizationId   String?          @default("org_default_realty") @map("organization_id")
  organization     Organization?    @relation(fields: [organizationId], references: [id])
  employeeId       String           @map("employee_id")
  employee         Employee         @relation("EmployeeAssignedTargets", fields: [employeeId], references: [id], onDelete: Cascade)
  title            String
  periodType       String           @default("MONTHLY") @map("period_type")
  month            Int?
  year             Int
  startDate        DateTime         @db.Date @map("start_date")
  endDate          DateTime         @db.Date @map("end_date")
  targetVisits     Int              @default(0) @map("target_visits")
  currentVisits    Int              @default(0) @map("current_visits")
  targetBookings   Int              @default(0) @map("target_bookings")
  currentBookings  Int              @default(0) @map("current_bookings")
  targetRevenue    Float            @default(0) @map("target_revenue")
  currentRevenue   Float            @default(0) @map("current_revenue")
  incentiveAmount  Float            @default(0) @map("incentive_amount")
  incentivePercent Float            @default(0) @map("incentive_percent")
  status           String           @default("IN_PROGRESS")
  isBonusAwarded   Boolean          @default(false) @map("is_bonus_awarded")
  createdById      String           @map("created_by_id")
  createdBy        Employee         @relation("EmployeeCreatedTargets", fields: [createdById], references: [id])
  notes            String?
  items            TargetItem[]
  activities       TargetActivity[]
  createdAt        DateTime         @default(now()) @map("created_at")
  updatedAt        DateTime         @default(now()) @updatedAt @map("updated_at")

  @@index([organizationId, employeeId, year, month])
  @@map("employee_targets")
}

model TargetItem {
  id             String           @id @default(cuid())
  targetId       String           @map("target_id")
  target         EmployeeTarget   @relation(fields: [targetId], references: [id], onDelete: Cascade)
  title          String
  category       String           @default("GENERAL") // SALES, HR, IT, OPERATIONS, GENERAL
  targetValue    Float            @default(0) @map("target_value")
  achievedValue  Float            @default(0) @map("achieved_value")
  unit           String           @default("Units") // "Visits", "Bookings", "Joinings", "Tasks", "INR", "Units"
  weightPercent  Float            @default(0) @map("weight_percent")
  notes          String?
  submissions    TargetActivity[]
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @default(now()) @updatedAt @map("updated_at")

  @@index([targetId])
  @@map("target_items")
}

model TargetActivity {
  id              String          @id @default(cuid())
  targetId        String          @map("target_id")
  target          EmployeeTarget  @relation(fields: [targetId], references: [id], onDelete: Cascade)
  targetItemId    String?         @map("target_item_id")
  targetItem      TargetItem?     @relation(fields: [targetItemId], references: [id], onDelete: SetNull)
  employeeId      String          @map("employee_id")
  employee        Employee        @relation("EmployeeTargetActivities", fields: [employeeId], references: [id], onDelete: Cascade)
  activityType    String          @map("activity_type")
  title           String?
  projectName     String?         @map("project_name")
  clientName      String?         @map("client_name")
  clientPhone     String?         @map("client_phone")
  unitNumber      String?         @map("unit_number")
  quantity        Float           @default(1)
  revenueAmount   Float           @default(0) @map("revenue_amount")
  activityDate    DateTime        @db.Date @map("activity_date")
  notes           String?
  proofUrl        String?         @map("proof_url")
  status          String          @default("PENDING") // PENDING, APPROVED, REJECTED
  verifiedById    String?         @map("verified_by_id")
  verifiedAt      DateTime?       @map("verified_at")
  rejectionReason String?         @map("rejection_reason")
  createdAt       DateTime        @default(now()) @map("created_at")

  @@index([targetId, employeeId])
  @@index([targetItemId])
  @@map("target_activities")
}
