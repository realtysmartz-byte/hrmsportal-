{
  "name": "realty-smartz-hrms",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "start": "pnpm --filter @realty-smartz/web start",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "db:generate": "turbo run db:generate",
    "db:push": "turbo run db:push --filter=@realty-smartz/db",
    "db:migrate": "turbo run db:migrate --filter=@realty-smartz/db",
    "db:seed": "turbo run db:seed --filter=@realty-smartz/db",
    "db:studio": "turbo run db:studio --filter=@realty-smartz/db"
  },
  "devDependencies": {
    "turbo": "^2.3.3",
    "typescript": "^5.7.2"
  },
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=18"
  },
  "pnpm": {
    "overrides": {
      "postcss": "^8.5.30",
      "source-map-js": "^1.2.2",
      "serialize-javascript": "^7.1.2",
      "deepmerge-ts": "^8.0.2",
      "sharp": "^0.35.5",
      "postcss-selector-parser": "^7.1.6"
    }
  }
}
