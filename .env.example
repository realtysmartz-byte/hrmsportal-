# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate-a-long-random-secret-here"

# Optional Upstash Redis cache (server-side only; PostgreSQL remains the source of truth)
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Supabase — encode special chars in password (@ → %40, [ → %5B, ] → %5D)
DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres"

# Google OAuth — Employee Portal only (not Admin/HR)
# Create credentials at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: {NEXTAUTH_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# SMTP — Hostinger mail (used for all HRMS notifications)
# Hostinger: smtp.hostinger.com | port 465 (SSL) or 587 (STARTTLS)
SMTP_HOST="smtp.hostinger.com"
SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_USER="info@realtysmartz.in"
SMTP_PASS=""
SMTP_FROM="Realty Smartz HRMS <info@realtysmartz.in>"
# Staff copy recipients (comma-separated OK)
ADMIN_NOTIFY_EMAIL="realtysmartz@gmail.com"
HR_NOTIFY_EMAIL="hr@realtysmartz.in"

# Optional: Google Maps Static API (better map images). Enable Maps Static API in Google Cloud.
# Without this key, the app still shows an embedded Google Map.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=""

# Google Sheets Daily Attendance Sync
# Google Sheets credentials must be defined exclusively in backend environment variables (.env):
GOOGLE_SHEETS_SPREADSHEET_ID=""
# Method A: Google Cloud Service Account
GOOGLE_SHEETS_SERVICE_ACCOUNT_EMAIL=""
GOOGLE_SHEETS_PRIVATE_KEY=""
# Method B: Google Apps Script Webhook (Alternative zero-GCP setup)
GOOGLE_SHEETS_WEBHOOK_URL=""
# Secret for automated daily cron endpoint /api/cron/sync-google-sheets
CRON_SECRET=""
