# ==============================================================================
# PAYROLL MODULE ENVIRONMENT VARIABLES
# ==============================================================================

# 1. Bank Account Number Encryption Key (AES-256-GCM)
# 32-character string or random secret used to encrypt/decrypt employee account numbers.
PAYROLL_ENCRYPTION_KEY="your-random-32-byte-hex-or-passphrase"

# 2. Safety Mode: Set to "true" for simulation (no real money moves). Set to "false" for live payouts.
PAYROLL_SANDBOX_MODE="true"

# 3. Payout Provider: Default is "razorpayx"
PAYROLL_PROVIDER="razorpayx"

# 4. RazorpayX Payout Credentials & Account
RAZORPAYX_KEY_ID="rzp_live_your_key_id"
RAZORPAYX_KEY_SECRET="your_razorpayx_key_secret"
RAZORPAYX_ACCOUNT_NUMBER="781234567890"

# 5. RazorpayX Webhook Verification Secret
RAZORPAYX_WEBHOOK_SECRET="your_razorpayx_webhook_secret"

